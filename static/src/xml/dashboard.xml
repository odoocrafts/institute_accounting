<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="institute_accounting.Dashboard" owl="1">
        <div class="o_action o_view_controller">
            <style>
                @media print {
                    .no-print, .o_main_navbar, .o_control_panel, header, nav, .btn, select {
                        display: none !important;
                    }
                    .o_content, .o_action, .container-fluid {
                        overflow: visible !important;
                        height: auto !important;
                        background: #ffffff !important;
                    }
                    .card {
                        break-inside: avoid;
                        box-shadow: none !important;
                        border: 1px solid #dee2e6 !important;
                    }
                }
            </style>

            <div class="o_content o_accounting_dashboard bg-light h-100">
                <div class="container-fluid py-4 h-100 overflow-auto">
                    <!-- Header Bar -->
                    <div class="row mb-4 align-items-center">
                        <div class="col-md-4 col-12 mb-2 mb-md-0">
                            <h2 class="text-dark fw-bolder mb-0">Accounting Overview</h2>
                        </div>
                        <div class="col-md-8 col-12 d-flex justify-content-md-end align-items-center flex-wrap gap-2 no-print">
                            <!-- Period Selection Dropdown -->
                            <div class="d-flex align-items-center bg-white rounded-3 shadow-sm px-3 py-1 border me-2">
                                <i class="fa fa-calendar text-primary me-2 ms-1 fs-5"></i>
                                <select class="form-select border-0 bg-transparent fw-bold text-dark shadow-none cursor-pointer" t-on-change="onPeriodChange" style="width: auto; min-width: 170px; font-size: 0.95rem;">
                                    <option value="current_month" t-att-selected="state.period === 'current_month'">Current Month</option>
                                    <option value="previous_month" t-att-selected="state.period === 'previous_month'">Previous Month</option>
                                    <option value="current_fy" t-att-selected="state.period === 'current_fy'">Current FY (Apr-Mar)</option>
                                </select>
                            </div>
                            <!-- Print PDF Button -->
                            <button class="btn btn-outline-dark shadow-sm fw-semibold me-2" t-on-click="printDashboard" title="Print Dashboard as PDF">
                                <i class="fa fa-print me-1"></i>Print PDF
                            </button>
                            <!-- New Transaction Button -->
                            <button class="btn btn-primary shadow-sm fw-semibold" t-on-click="openNewTransaction">
                                <i class="fa fa-plus me-1"></i>New Transaction
                            </button>
                        </div>
                    </div>

                    <t t-if="state.loading">
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <!-- Top Cards -->
                        <div class="row g-4 mb-4">
                            <!-- Income Card -->
                            <div class="col-md-3">
                                <div class="card h-100 border-0 shadow-sm rounded-4 pt-1" style="background-color: #ffffff; border-top: 5px solid #10b981 !important;">
                                    <div class="card-body p-4">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="text-uppercase fw-bold mb-0" style="color: #1f2937; font-size: 0.85rem; letter-spacing: 0.5px;">INCOME</h6>
                                            <i class="fa fa-arrow-down fs-4 text-success"></i>
                                        </div>
                                        <h2 class="mb-1 fw-bolder" style="color: #111827;"><t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.income_month)"/></h2>
                                        <small class="fw-bold" style="color: #4b5563;">Today: <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.income_today)"/></small>
                                    </div>
                                </div>
                            </div>
                            <!-- Expenses Card -->
                            <div class="col-md-3">
                                <div class="card h-100 border-0 shadow-sm rounded-4 pt-1" style="background-color: #ffffff; border-top: 5px solid #ef4444 !important;">
                                    <div class="card-body p-4">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="text-uppercase fw-bold mb-0" style="color: #1f2937; font-size: 0.85rem; letter-spacing: 0.5px;">EXPENSES</h6>
                                            <i class="fa fa-arrow-up fs-4 text-danger"></i>
                                        </div>
                                        <h2 class="mb-1 fw-bolder" style="color: #111827;"><t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.expense_month)"/></h2>
                                        <small class="fw-bold" style="color: #4b5563;">Today: <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.expense_today)"/></small>
                                    </div>
                                </div>
                            </div>
                            <!-- Cash Balance Card -->
                            <div class="col-md-3">
                                <div class="card h-100 border-0 shadow-sm rounded-4 pt-1" style="background-color: #ffffff; border-top: 5px solid #3b82f6 !important;">
                                    <div class="card-body p-4">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="text-uppercase fw-bold mb-0" style="color: #1f2937; font-size: 0.85rem; letter-spacing: 0.5px;">CASH BALANCE</h6>
                                            <i class="fa fa-money fs-4 text-primary"></i>
                                        </div>
                                        <h2 class="mb-1 fw-bolder" style="color: #111827;"><t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.cash_balance)"/></h2>
                                        <small class="fw-bold" style="color: #4b5563;">Real-time Cash Accounts</small>
                                    </div>
                                </div>
                            </div>
                            <!-- Bank Balance Card -->
                            <div class="col-md-3">
                                <div class="card h-100 border-0 shadow-sm rounded-4 pt-1" style="background-color: #ffffff; border-top: 5px solid #06b6d4 !important;">
                                    <div class="card-body p-4">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="text-uppercase fw-bold mb-0" style="color: #1f2937; font-size: 0.85rem; letter-spacing: 0.5px;">BANK BALANCE</h6>
                                            <i class="fa fa-university fs-4 text-info"></i>
                                        </div>
                                        <h2 class="mb-1 fw-bolder" style="color: #111827;"><t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.bank_balance)"/></h2>
                                        <small class="fw-bold" style="color: #4b5563;">Real-time Bank &amp; UPI</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Secondary Cards & Top Expenses -->
                        <div class="row g-4 mb-4">
                            <div class="col-md-4">
                                <div class="card border-0 shadow-sm rounded-4 h-100 pt-1" style="background-color: #ffffff; border-top: 5px solid #f59e0b !important;">
                                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                                        <div>
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <h6 class="text-uppercase fw-bold mb-0" style="color: #1f2937; font-size: 0.85rem; letter-spacing: 0.5px;">TOTAL FEE DUE</h6>
                                                <i class="fa fa-exclamation-circle fs-4 text-warning"></i>
                                            </div>
                                            <h2 class="mb-1 fw-bolder" style="color: #111827;"><t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.fee_due)"/></h2>
                                        </div>
                                        <small class="fw-bold" style="color: #4b5563;">Uncollected Student Dues</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="card border-0 shadow-sm rounded-4 h-100">
                                    <div class="card-body p-4">
                                        <h6 class="text-uppercase fw-bold mb-3" style="color: #1f2937; font-size: 0.85rem; letter-spacing: 0.5px;">TOP EXPENSE CATEGORIES (<t t-esc="state.data.period_label.toUpperCase()"/>)</h6>
                                        <div class="table-responsive">
                                            <table class="table table-borderless table-sm align-middle mb-0">
                                                <tbody>
                                                    <t t-foreach="state.data.top_expenses" t-as="exp" t-key="exp.category">
                                                        <tr>
                                                            <td class="fw-bold text-dark py-2" style="color: #1f2937;"><t t-esc="exp.category"/></td>
                                                            <td class="text-end fw-bold text-danger py-2" style="color: #dc2626;"><t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(exp.amount)"/></td>
                                                        </tr>
                                                    </t>
                                                    <t t-if="!state.data.top_expenses.length">
                                                        <tr><td class="text-muted py-2">No expenses recorded for this period.</td></tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Charts Section -->
                        <div class="row g-4 mb-4">
                            <!-- Pie Chart -->
                            <div class="col-md-6 mb-4">
                                <div class="card border-0 shadow-sm rounded-4 h-100">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold text-dark mb-3">
                                            <t t-if="state.data.is_manager">Branch Wise Fee Due</t>
                                            <t t-else="">Course Wise Fee Due</t>
                                        </h5>
                                        <div style="position: relative; height:300px; width:100%">
                                            <canvas t-ref="branchDueChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Bar Chart -->
                            <div class="col-md-6 mb-4">
                                <div class="card border-0 shadow-sm rounded-4 h-100">
                                    <div class="card-body p-4">
                                        <h5 class="fw-bold text-dark mb-3">
                                            <t t-if="state.data.is_manager">Branch Wise Income &amp; Expense (<t t-esc="state.data.period_label"/>)</t>
                                            <t t-else="">Income vs Expense (<t t-esc="state.data.period_label"/>)</t>
                                        </h5>
                                        <div style="position: relative; height:300px; width:100%">
                                            <canvas t-ref="branchIncomeChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Manager Specific Section: Branch Performance & Balances -->
                        <t t-if="state.data.is_manager">
                            <!-- 1. Branch Cash & Bank Balances -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card border-0 shadow-sm rounded-4">
                                        <div class="card-body p-4">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <div>
                                                    <h5 class="fw-bold text-dark mb-1">
                                                        <i class="fa fa-university text-primary me-2"></i>Branch Cash &amp; Bank Balances
                                                    </h5>
                                                    <small class="text-muted">Real-time liquid account balances per branch</small>
                                                </div>
                                                <span class="badge bg-primary-subtle text-primary border border-primary rounded-pill px-3 py-2">
                                                    <t t-esc="state.data.branch_metrics.length"/> Branches
                                                </span>
                                            </div>
                                            <div class="table-responsive">
                                                <table class="table table-hover align-middle mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th class="fw-bold" style="color: #1f2937;">Branch Name</th>
                                                            <th class="text-end fw-bold" style="color: #1f2937;">Cash Balance</th>
                                                            <th class="text-end fw-bold" style="color: #1f2937;">Bank Balance</th>
                                                            <th class="text-end fw-bold" style="color: #1f2937;">Total Liquid Balance</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <t t-foreach="state.data.branch_metrics" t-as="bm" t-key="bm.name">
                                                            <tr>
                                                                <td class="fw-bold text-dark"><t t-esc="bm.name"/></td>
                                                                <td class="text-end fw-semibold text-primary">
                                                                    <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(bm.cash_balance)"/>
                                                                </td>
                                                                <td class="text-end fw-semibold text-info">
                                                                    <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(bm.bank_balance)"/>
                                                                </td>
                                                                <td class="text-end fw-bold text-dark">
                                                                    <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(bm.total_balance)"/>
                                                                </td>
                                                            </tr>
                                                        </t>
                                                    </tbody>
                                                    <tfoot class="table-light fw-bolder border-top border-2">
                                                        <tr>
                                                            <td style="color: #1f2937;">Total All Branches</td>
                                                            <td class="text-end text-primary">
                                                                <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.branch_totals.cash_balance)"/>
                                                            </td>
                                                            <td class="text-end text-info">
                                                                <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.branch_totals.bank_balance)"/>
                                                            </td>
                                                            <td class="text-end text-dark fs-6">
                                                                <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.branch_totals.total_balance)"/>
                                                            </td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 2. Branch Performance & PnL Overview -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card border-0 shadow-sm rounded-4">
                                        <div class="card-body p-4">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <div>
                                                    <h5 class="fw-bold text-dark mb-1">
                                                        <i class="fa fa-line-chart text-success me-2"></i>Branch Performance Overview (<t t-esc="state.data.period_label"/>)
                                                    </h5>
                                                    <small class="text-muted">Consolidated summary of fee due, income, expenses, and PnL per branch</small>
                                                </div>
                                            </div>
                                            <div class="table-responsive">
                                                <table class="table table-hover align-middle mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th class="fw-bold" style="color: #1f2937;">Branch Name</th>
                                                            <th class="text-end fw-bold" style="color: #1f2937;">Total Due</th>
                                                            <th class="text-end fw-bold" style="color: #1f2937;">Income (<t t-esc="state.data.period_label"/>)</th>
                                                            <th class="text-end fw-bold" style="color: #1f2937;">Expense (<t t-esc="state.data.period_label"/>)</th>
                                                            <th class="text-end fw-bold" style="color: #1f2937;">Net PnL / Profit</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <t t-foreach="state.data.branch_metrics" t-as="bm" t-key="bm.name">
                                                            <tr>
                                                                <td class="fw-bold text-dark"><t t-esc="bm.name"/></td>
                                                                <td class="text-end fw-semibold text-warning">
                                                                    <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(bm.fee_due)"/>
                                                                </td>
                                                                <td class="text-end fw-semibold text-success">
                                                                    <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(bm.income)"/>
                                                                </td>
                                                                <td class="text-end fw-semibold text-danger">
                                                                    <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(bm.expense)"/>
                                                                </td>
                                                                <td class="text-end fw-bold">
                                                                    <span t-attf-class="badge rounded-pill px-3 py-2 {{ bm.profit >= 0 ? 'bg-success text-white' : 'bg-danger text-white' }}">
                                                                        <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(bm.profit)"/>
                                                                    </span>
                                                                </td>
                                                            </tr>
                                                        </t>
                                                    </tbody>
                                                    <tfoot class="table-light fw-bolder border-top border-2">
                                                        <tr>
                                                            <td style="color: #1f2937;">Total All Branches</td>
                                                            <td class="text-end text-warning">
                                                                <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.branch_totals.fee_due)"/>
                                                            </td>
                                                            <td class="text-end text-success">
                                                                <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.branch_totals.income)"/>
                                                            </td>
                                                            <td class="text-end text-danger">
                                                                <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.branch_totals.expense)"/>
                                                            </td>
                                                            <td class="text-end">
                                                                <span t-attf-class="badge rounded-pill px-3 py-2 fs-6 {{ state.data.branch_totals.profit >= 0 ? 'bg-success text-white' : 'bg-danger text-white' }}">
                                                                    <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.branch_totals.profit)"/>
                                                                </span>
                                                            </td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
