<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="institute_accounting.Dashboard" owl="1">
        <div class="o_action o_view_controller">
            <div class="o_content o_accounting_dashboard bg-light h-100">
                <div class="container-fluid py-4 h-100 overflow-auto">
                    <!-- Header -->
                    <div class="row mb-4">
                        <div class="col-12 d-flex justify-content-between align-items-center">
                            <h2 class="text-primary fw-bold mb-0">Accounting Overview</h2>
                            <button class="btn btn-primary" t-on-click="openNewTransaction">
                                <i class="fa fa-plus me-2"></i>New Transaction
                            </button>
                        </div>
                    </div>

                    <t t-if="state.loading">
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <!-- Top Cards -->
                        <div class="row g-4 mb-4">
                            <!-- Income Month -->
                            <div class="col-md-3">
                                <div class="card h-100 border-0 shadow-sm rounded-4 bg-success text-dark pt-2">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h6 class="text-uppercase fw-bold mb-0 text-muted">Income (This Month)</h6>
                                            <i class="fa fa-arrow-down fa-2x opacity-50"></i>
                                        </div>
                                        <h3 class="mb-0 fw-bolder"><t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.income_month)"/></h3>
                                        <small class="text-muted">Today: <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.income_today)"/></small>
                                    </div>
                                </div>
                            </div>
                            <!-- Expense Month -->
                            <div class="col-md-3">
                                <div class="card h-100 border-0 shadow-sm rounded-4 bg-danger text-dark pt-2">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h6 class="text-uppercase fw-bold mb-0 text-muted">Expenses (This Month)</h6>
                                            <i class="fa fa-arrow-up fa-2x opacity-50"></i>
                                        </div>
                                        <h3 class="mb-0 fw-bolder"><t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.expense_month)"/></h3>
                                        <small class="text-muted">Today: <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.expense_today)"/></small>
                                    </div>
                                </div>
                            </div>
                             <!-- Cash Balance -->
                            <div class="col-md-3">
                                <div class="card h-100 border-0 shadow-sm rounded-4 bg-primary text-dark pt-2">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h6 class="text-uppercase fw-bold mb-0 text-muted">Cash Balance</h6>
                                            <i class="fa fa-money fa-2x opacity-50"></i>
                                        </div>
                                        <h3 class="mb-0 fw-bolder"><t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.cash_balance)"/></h3>
                                    </div>
                                </div>
                            </div>
                            <!-- Bank Balance -->
                            <div class="col-md-3">
                                <div class="card h-100 border-0 shadow-sm rounded-4 bg-info text-dark pt-2">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h6 class="text-uppercase fw-bold mb-0 text-muted">Bank Balance</h6>
                                            <i class="fa fa-university fa-2x opacity-50"></i>
                                        </div>
                                        <h3 class="mb-0 fw-bolder"><t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.bank_balance)"/></h3>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Secondary Cards & Top Expenses -->
                        <div class="row g-4 mb-4">
                            <div class="col-md-4">
                                <div class="card border-0 shadow-sm rounded-4 mb-4">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h6 class="text-uppercase fw-bold text-muted mb-0">Total Fee Due</h6>
                                            <i class="fa fa-exclamation-circle fa-2x text-warning opacity-50"></i>
                                        </div>
                                        <h3 class="mb-0 text-dark fw-bolder"><t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.fee_due)"/></h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="card border-0 shadow-sm rounded-4 h-100">
                                    <div class="card-body">
                                        <h6 class="text-uppercase fw-bold text-muted mb-4">Top Expense Categories (This Month)</h6>
                                        <div class="table-responsive">
                                            <table class="table table-borderless table-sm">
                                                <tbody>
                                                    <t t-foreach="state.data.top_expenses" t-as="exp" t-key="exp.category">
                                                        <tr>
                                                            <td class="fw-bold text-dark"><t t-esc="exp.category"/></td>
                                                            <td class="text-end fw-bold text-danger"><t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(exp.amount)"/></td>
                                                        </tr>
                                                    </t>
                                                    <t t-if="!state.data.top_expenses.length">
                                                        <tr><td class="text-muted">No expenses recorded this month.</td></tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Charts Section -->
                        <div class="row mb-4">
                            <!-- Pie Chart -->
                            <div class="col-md-6 mb-4">
                                <div class="card border-0 shadow-sm rounded-4 h-100">
                                    <div class="card-body">
                                        <h5 class="fw-bold text-dark mb-3">
                                            <t t-if="state.data.is_manager">Branch Wise Fee Due</t>
                                            <t t-else="">Course Wise Fee Due</t>
                                        </h5>
                                        <div style="position: relative; height:300px; width:100%">
                                            <canvas t-ref="branchDueChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Bar Chart -->
                            <div class="col-md-6 mb-4">
                                <div class="card border-0 shadow-sm rounded-4 h-100">
                                    <div class="card-body">
                                        <h5 class="fw-bold text-dark mb-3">
                                            <t t-if="state.data.is_manager">Branch Wise Income &amp; Expense</t>
                                            <t t-else="">Income vs Expense</t>
                                        </h5>
                                        <div style="position: relative; height:300px; width:100%">
                                            <canvas t-ref="branchIncomeChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Manager Specific Section: Branch Performance & Balances -->
                        <t t-if="state.data.is_manager">
                            <!-- 1. Branch Cash & Bank Balances -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card border-0 shadow-sm rounded-4">
                                        <div class="card-body p-4">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <div>
                                                    <h5 class="fw-bold text-dark mb-1">
                                                        <i class="fa fa-university text-primary me-2"></i>Branch Cash &amp; Bank Balances
                                                    </h5>
                                                    <small class="text-muted">Real-time liquid account balances per branch</small>
                                                </div>
                                                <span class="badge bg-primary-subtle text-primary border border-primary rounded-pill px-3 py-2">
                                                    <t t-esc="state.data.branch_metrics.length"/> Branches
                                                </span>
                                            </div>
                                            <div class="table-responsive">
                                                <table class="table table-hover align-middle mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th class="fw-bold">Branch Name</th>
                                                            <th class="text-end fw-bold">Cash Balance</th>
                                                            <th class="text-end fw-bold">Bank Balance</th>
                                                            <th class="text-end fw-bold">Total Liquid Balance</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <t t-foreach="state.data.branch_metrics" t-as="bm" t-key="bm.name">
                                                            <tr>
                                                                <td class="fw-bold text-dark"><t t-esc="bm.name"/></td>
                                                                <td class="text-end fw-semibold text-primary">
                                                                    <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(bm.cash_balance)"/>
                                                                </td>
                                                                <td class="text-end fw-semibold text-info">
                                                                    <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(bm.bank_balance)"/>
                                                                </td>
                                                                <td class="text-end fw-bold text-dark">
                                                                    <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(bm.total_balance)"/>
                                                                </td>
                                                            </tr>
                                                        </t>
                                                    </tbody>
                                                    <tfoot class="table-light fw-bolder border-top border-2">
                                                        <tr>
                                                            <td>Total All Branches</td>
                                                            <td class="text-end text-primary">
                                                                <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.branch_totals.cash_balance)"/>
                                                            </td>
                                                            <td class="text-end text-info">
                                                                <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.branch_totals.bank_balance)"/>
                                                            </td>
                                                            <td class="text-end text-dark fs-6">
                                                                <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.branch_totals.total_balance)"/>
                                                            </td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 2. Branch Performance & PnL Overview -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card border-0 shadow-sm rounded-4">
                                        <div class="card-body p-4">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <div>
                                                    <h5 class="fw-bold text-dark mb-1">
                                                        <i class="fa fa-line-chart text-success me-2"></i>Branch Performance Overview (This Month)
                                                    </h5>
                                                    <small class="text-muted">Consolidated summary of fee due, income, expenses, and PnL per branch</small>
                                                </div>
                                            </div>
                                            <div class="table-responsive">
                                                <table class="table table-hover align-middle mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th class="fw-bold">Branch Name</th>
                                                            <th class="text-end fw-bold">Total Due</th>
                                                            <th class="text-end fw-bold">Income (This Month)</th>
                                                            <th class="text-end fw-bold">Expense (This Month)</th>
                                                            <th class="text-end fw-bold">Net PnL / Profit</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <t t-foreach="state.data.branch_metrics" t-as="bm" t-key="bm.name">
                                                            <tr>
                                                                <td class="fw-bold text-dark"><t t-esc="bm.name"/></td>
                                                                <td class="text-end fw-semibold text-warning">
                                                                    <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(bm.fee_due)"/>
                                                                </td>
                                                                <td class="text-end fw-semibold text-success">
                                                                    <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(bm.income)"/>
                                                                </td>
                                                                <td class="text-end fw-semibold text-danger">
                                                                    <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(bm.expense)"/>
                                                                </td>
                                                                <td class="text-end fw-bold">
                                                                    <span t-attf-class="badge rounded-pill px-3 py-2 {{ bm.profit >= 0 ? 'bg-success text-white' : 'bg-danger text-white' }}">
                                                                        <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(bm.profit)"/>
                                                                    </span>
                                                                </td>
                                                            </tr>
                                                        </t>
                                                    </tbody>
                                                    <tfoot class="table-light fw-bolder border-top border-2">
                                                        <tr>
                                                            <td>Total All Branches</td>
                                                            <td class="text-end text-warning">
                                                                <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.branch_totals.fee_due)"/>
                                                            </td>
                                                            <td class="text-end text-success">
                                                                <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.branch_totals.income)"/>
                                                            </td>
                                                            <td class="text-end text-danger">
                                                                <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.branch_totals.expense)"/>
                                                            </td>
                                                            <td class="text-end">
                                                                <span t-attf-class="badge rounded-pill px-3 py-2 fs-6 {{ state.data.branch_totals.profit >= 0 ? 'bg-success text-white' : 'bg-danger text-white' }}">
                                                                    <t t-esc="state.data.currency_symbol"/> <t t-esc="formatNumber(state.data.branch_totals.profit)"/>
                                                                </span>
                                                            </td>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
